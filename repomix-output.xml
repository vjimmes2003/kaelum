<BaseLayout
  title="Kaelum — Enemigos"
  description="Enemigos del proyecto Kaelum: roles, facciones, lectura visual y diseño de combate."
>
  <section class="hero">
    <header class="header">
      <p class="kicker">GDD · Combate</p>
      <h1>Enemigos</h1>
