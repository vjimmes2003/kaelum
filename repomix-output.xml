    }

    .hub-card.analisis {
      background: linear-gradient(
        180deg,
        rgba(255, 120, 160, 0.08),
        rgba(255, 255, 255, 0.03)
      );
    }

    .hub-card.planificacion {
      background: linear-gradient(
        180deg,
        rgba(120, 210, 150, 0.1),
        rgba(255, 255, 255, 0.03)
      );
    }

    .hub-card.metricas {
      background: linear-gradient(
        180deg,
        rgba(34, 211, 238, 0.08),
        rgba(255, 255, 255, 0.03)
      );
    }

    .hub-card.presupuesto {
      background: linear-gradient(
        180deg,
        rgba(139, 92, 246, 0.08),
        rgba(255, 255, 255, 0.03)
      );
    }

    .hub-card.equipo {
      background: linear-gradient(
        180deg,
        rgba(90, 160, 255, 0.08),
        rgba(255, 255, 255, 0.03)
      );
    }

    .hub-card.difusion {
      background: linear-gradient(
        180deg,
        rgba(34, 211, 238, 0.1),
        rgba(255, 255, 255, 0.03)
      );
    }

    .hub-card.folleto {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.06),
        rgba(255, 255, 255, 0.03)
      );
    }

    .hub-card.full {
      grid-column: 1 / -1;
    }

    .hub-number {
      width: 44px;
      height: 44px;
      flex: 0 0 auto;
      border-radius: 14px;
      display: grid;
      place-items: center;
      font-weight: 900;
      border: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.18);
      color: var(--text);
    }

    .hub-copy h2 {
      margin: 2px 0 8px;
      font-size: 1.45rem;
    }

    .hub-copy p {
      margin: 0;
      color: var(--muted);
      line-height: 1.55;
    }

    .hub-cta {
      display: inline-block;
      margin-top: 14px;
      font-weight: 800;
      color: var(--text);
    }

    @media (max-width: 860px) {
      .hub-grid {
        grid-template-columns: 1fr;
      }

      .hub-card.full {
        grid-column: auto;
      }

      .hub-card {
        padding: 18px;
      }
    }
  </style>
</BaseLayout>
</file>

<file path="public/styles/global.css">
:root{
  --bg: #0b1020;
  --text: rgba(255,255,255,.92);
  --muted: rgba(255,255,255,.72);
  --muted2: rgba(255,255,255,.55);

  --surface: rgba(255,255,255,.05);
  --surface2: rgba(0,0,0,.22);
  --border: rgba(255,255,255,.10);

  --shadow: 0 18px 60px rgba(0,0,0,.35);
  --radius: 18px;

  --accent: rgba(139,92,246,1);
  --accent2: rgba(34,211,238,1);
}

*{ box-sizing: border-box; }

html, body { min-height: 100%; }

body{
  margin:0;
  font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  color: var(--text);
  line-height: 1.6;
  background: var(--bg);
  background-attachment: fixed;
  overflow-x: hidden;
  display:flex;
  flex-direction: column;
}

/* Fondo animado sin cortes */
body::before,
body::after{
  content:"";
  position: fixed;
  inset: -40%;
  z-index: -2;
  pointer-events: none;
  filter: blur(50px);
  opacity: .85;
  transform: translate3d(0,0,0);
}

body::before{
  background:
    radial-gradient(35% 30% at 20% 20%, rgba(139,92,246,.35), transparent 60%),
    radial-gradient(30% 30% at 80% 15%, rgba(34,211,238,.25), transparent 55%),
    radial-gradient(40% 35% at 60% 80%, rgba(139,92,246,.22), transparent 60%);
  animation: driftA 18s ease-in-out infinite alternate;
}

body::after{
  z-index: -3;
  background:
    radial-gradient(40% 35% at 25% 70%, rgba(34,211,238,.14), transparent 60%),
    radial-gradient(35% 35% at 70% 60%, rgba(139,92,246,.16), transparent 65%);
  animation: driftB 24s ease-in-out infinite alternate;
  opacity: .75;
}

@keyframes driftA{
  0%   { transform: translate(-2%, -2%) scale(1.02); }
  50%  { transform: translate(2%, 1%) scale(1.06); }
  100% { transform: translate(1%, 3%) scale(1.04); }
}

@keyframes driftB{
  0%   { transform: translate(2%, 2%) scale(1.03); }
  50%  { transform: translate(-1%, 1%) scale(1.07); }
  100% { transform: translate(-2%, -2%) scale(1.05); }
}

@media (prefers-reduced-motion: reduce){
  body::before, body::after{ animation: none; }
}

/* Layout */
.wrap{
  width: min(1100px, calc(100% - 28px));
  margin: 22px auto 54px;
  flex:1;
  min-width: 75vw;
}

.topbar{
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(12px);
  background: rgba(10,14,28,.55);
  border-bottom: 1px solid var(--border);
}

.topbar-inner{
  width: min(1100px, calc(100% - 28px));
  margin: 0 auto;
  display:flex;
  align-items:center;
  justify-content: space-between;
  gap: 14px;
  padding: 14px 0;
}

.brand{
  display:flex;
  align-items:center;
  gap: 10px;
  text-decoration:none;
  color: var(--text);
  font-weight: 900;
  letter-spacing: .2px;
}
.brand-dot{
  width: 22px;
  height: 22px;
  border-radius: 8px;
  background: linear-gradient(135deg, rgba(139,92,246,1), rgba(34,211,238,1));
  box-shadow: 0 10px 30px rgba(0,0,0,.35);
}
.brand-name{ font-size: 1.05rem; }

.nav{
  display:flex;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.pill{
  text-decoration:none;
  color: var(--muted);
  border: 1px solid var(--border);
  background: rgba(255,255,255,.03);
  padding: 7px 12px;
  border-radius: 999px;
  transition: transform .12s ease, background .12s ease, color .12s ease;
  font-weight: 700;
  font-size: .95rem;
}
.pill:hover{ transform: translateY(-1px); background: rgba(255,255,255,.06); color: var(--text); }
.pill.active{
  color: var(--text);
  background: rgba(139,92,246,.18);
  border-color: rgba(139,92,246,.35);
}

.footer{
  border-top: 1px solid var(--border);
  background: rgba(10,14,28,.35);
}
.footer-inner{
  width: min(1100px, calc(100% - 28px));
  margin: 0 auto;
  padding: 16px 0;
  display:flex;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  color: var(--muted2);
}

/* Common blocks */
.hero{
  border: 1px solid var(--border);
  background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
  border-radius: calc(var(--radius) + 6px);
  box-shadow: var(--shadow);
  padding: 18px;
}

.kicker{
  margin: 0 0 6px;
  color: var(--muted2);
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: .12em;
  font-size: .82rem;
}
h1{ margin: 0; font-size: 2.1rem; line-height: 1.1; }
h2{ margin: 0 0 10px; font-size: 1.4rem; }
h3{ margin: 0 0 8px; font-size: 1.05rem; }

.lead{
  margin: 10px 0 0;
  color: var(--muted);
  max-width: 70ch;
}

.actions{
  display:flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 14px;
  justify-content: center;
  flex-direction: row;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap: 8px;
  text-decoration:none;
  color: var(--text);
  border: 1px solid var(--border);
  background: rgba(255,255,255,.04);
  padding: 10px 14px;
  border-radius: 12px;
  font-weight: 900;
  transition: transform .12s ease, background .12s ease, border-color .12s ease;
}
.btn:hover{ transform: translateY(-1px); background: rgba(255,255,255,.07); }
.btn.primary{
  background: linear-gradient(135deg, rgba(139,92,246,.9), rgba(34,211,238,.55));
  border-color: rgba(255,255,255,.18);
}

.tag{
  display:inline-flex;
  align-items:center;
  border: 1px solid var(--border);
  background: rgba(0,0,0,.18);
  padding: 6px 10px;
  border-radius: 999px;
  font-weight: 800;
  color: var(--muted);
  font-size: .9rem;
}

.meta{
  display:flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.grid{
  margin-top: 14px;
  display:grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 12px;
}

.card{
  grid-column: span 6;
  border: 1px solid var(--border);
  background: rgba(0,0,0,.18);
  border-radius: var(--radius);
  padding: 14px;
  box-shadow: 0 16px 40px rgba(0,0,0,.28);
}

.card.full{ grid-column: span 12; }

.list{
  margin: 8px 0 0;
  padding-left: 18px;
  color: var(--muted);
}

.muted{ color: var(--muted); }
.small{ font-size: .95rem; color: var(--muted2); }

@media (max-width: 860px){
  .card{ grid-column: span 12; }
  h1{ font-size: 1.8rem; }
}

.pdf-shell{
      border: 1px solid var(--border);
      background: rgba(255,255,255,.03);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: 0 18px 60px rgba(0,0,0,.35);
      margin-top: 10px;
    }
.pdf-object{
  width: 100%;
  height: min(78vh, 980px);
  display: block;
  background: rgba(0,0,0,.2);
}
.pdf-fallback{ padding: 16px; }
.wrap{
  min-height: calc(100vh - 160px);
}
/* =========================
   Ajuste general de altura
   ========================= */
.wrap{
  min-height: calc(100vh - 325px);
  padding-top: 10px;
  padding-bottom: 26px;
}

/* =========================
   Brand / logo
   ========================= */
.brand-logo{
  width: 56px;
  height: 56px;
  object-fit: contain;
  display: block;
  filter: drop-shadow(0 10px 24px rgba(0,0,0,.35));
}

.brand-copy{
  display:flex;
  flex-direction:column;
  line-height:1.05;
}

.brand-subtitle{
  font-size: .84rem;
  color: var(--muted);
  font-weight: 700;
  margin-top: 3px;
}

/* =========================
   Footer completo
   ========================= */
.footer{
  border-top: 1px solid var(--border);
  background: rgba(10,14,28,.40);
  backdrop-filter: blur(10px);
}

.footer-inner{
  width: min(1100px, calc(100% - 28px));
  margin: 0 auto;
  padding: 26px 0 22px;
  display:grid;
  grid-template-columns: 1.2fr .9fr .8fr;
  gap: 24px;
  align-items:start;
}

.footer-block{
  display:flex;
  flex-direction:column;
  gap: 10px;
}

.footer-title{
  margin:0;
  font-weight: 900;
  font-size: 1.05rem;
  color: var(--text);
}

.footer-text{
  margin:0;
  color: var(--muted);
  line-height: 1.6;
  max-width: 58ch;
}

.footer-links{
  display:flex;
  flex-wrap:wrap;
  gap: 10px 12px;
  align-content:flex-start;
}

.footer-links a{
  color: var(--muted);
  text-decoration:none;
  font-weight: 700;
  transition: color .12s ease, transform .12s ease;
}

.footer-links a:hover{
  color: var(--text);
  transform: translateY(-1px);
}

.footer-meta{
  display:flex;
  flex-direction:column;
  gap: 8px;
  align-items:flex-end;
  text-align:right;
  color: var(--muted2);
}

/* =========================
   Cards que son links
   ========================= */
a.card{
  text-decoration:none;
  color: var(--text);
  transition: transform .14s ease, border-color .14s ease, background .14s ease;
}

a.card:hover{
  transform: translateY(-2px);
  background: rgba(255,255,255,.05);
  border-color: rgba(255,255,255,.16);
}

a.card h2,
a.card h3,
a.card p,
a.card .muted,
a.card .small{
  color: inherit;
  text-decoration:none;
}

/* =========================
   Hero más respirado
   ========================= */
.hero{
  padding: 24px;
}

/* =========================
   Responsive
   ========================= */
@media (max-width: 980px){
  .footer-inner{
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .footer-meta{
    align-items:flex-start;
    text-align:left;
  }

  .brand-logo{
    width: 48px;
    height: 48px;
  }
}

@media (max-width: 640px){
  .wrap{
    min-height: calc(100vh - 250px);
    padding-bottom: 18px;
  }

  .hero{
    padding: 18px;
  }

  .brand-subtitle{
    font-size: .78rem;
  }
}
