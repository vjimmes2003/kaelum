      transition:
        transform 0.14s ease,
        background 0.14s ease,
        border-color 0.14s ease;
    }

    .hub-card:hover {
      transform: translateY(-2px);
      border-color: rgba(255, 255, 255, 0.16);
    }

    .hub-card.gdd {
      background: linear-gradient(
        180deg,
        rgba(255, 180, 90, 0.1),
        rgba(255, 255, 255, 0.03)
