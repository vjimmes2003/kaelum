    }

    .card-container {
      margin-top: 18px;
      display: grid;
      gap: 16px;
    }

    .featured-card {
      border-color: rgba(255, 110, 170, 0.18);
      background: linear-gradient(
        180deg,
        rgba(255, 110, 170, 0.08),
        rgba(255, 255, 255, 0.03)
      );
    }

    .pgrid {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 16px;
      margin-top: 14px;
      align-items: start;
    }

    .portrait {
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(0, 0, 0, 0.18);
      min-height: 320px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .portrait img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .pcontent {
      display: grid;
      gap: 12px;
    }

    .grid2 {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
